{
  "name": "java-spring-ai-kb",
  "private": true,
  "description": "Static HTML knowledge base — Prettier formatting only (no build step for GitHub Pages).",
  "scripts": {
    "format:html": "prettier --write index.html interview.html \"java-architect-interview/*.html\" \"java-design-patterns-principles/**/*.html\" \"Software-Engineering-Core-Philosophical-Principles-and-Methodologies/**/*.html\" \"Software-Engineering-Laws-Theories-Principles-and-Patterns/**/*.html\" && python3 .workbuddy/skills/java-kb-expand/scripts/normalize_html_closers.py",
    "format:html:check": "python3 .workbuddy/skills/java-kb-expand/scripts/check_html_format.py",
    "format:html:prepare": "python3 .workbuddy/skills/java-kb-expand/scripts/ensure_mermaid_prettier_ignore.py",
    "validate:satellites": "python3 .workbuddy/skills/java-kb-expand/scripts/validate_satellite_sites.py",
    "validate:kb": "python3 .workbuddy/skills/java-kb-expand/scripts/validate_kb.py",
    "audit:colors": "python3 docs/scripts/audit_catppuccin.py",
    "audit:colors:probe": "python3 docs/scripts/probe_catppuccin_gate.py",
    "audit:dedup": "python3 .workbuddy/skills/java-kb-expand/scripts/audit_cross_axis_dedup.py",
    "audit:dedup:probe": "python3 .workbuddy/skills/java-kb-expand/scripts/probe_cross_axis_dedup_gate.py"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
